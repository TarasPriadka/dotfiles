#!/usr/bin/env python3
"""Uncommit the current branch back to its PR's parent, preserving local files."""

import argparse
import subprocess
import sys


def run(*args: str) -> str:
    result = subprocess.run(args, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"{' '.join(args)} failed")
    return result.stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", metavar="REF", help="use a local base ref instead of the PR target")
    args = parser.parse_args()
    try:
        base = args.base
        if not base:
            parent = run("gh", "pr", "view", "--json", "baseRefName", "--jq", ".baseRefName")
            base = "origin/" + parent
        target = run("git", "merge-base", "--", "HEAD", base)
        if target == run("git", "rev-parse", "HEAD"):
            print(f"No branch commits to uncommit against {base}.")
            return 0
        run("git", "reset", "--soft", target)
        print(f"Uncommitted branch changes against {base}; local edits preserved.")
    except (RuntimeError, OSError) as error:
        print(f"git uncommit: {error}", file=sys.stderr)
        print("Use --base <local-ref> to specify the parent branch explicitly.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
