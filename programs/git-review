#!/usr/bin/env python3
"""Fetch a branch and stage its PR diff, discarding the previous staged review."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import hashlib
import json
import os
from pathlib import Path
import shlex
import stat
import subprocess
import sys
import tempfile
from typing import Optional
from urllib.parse import urlsplit


def run(*args: str, optional: bool = False) -> str:
    result = subprocess.run(args, text=True, capture_output=True)
    if result.returncode:
        if optional and result.returncode == 1:
            return ""
        raise RuntimeError(result.stderr.strip() or f"{' '.join(args)} failed")
    return result.stdout.rstrip("\n")


def git(*args: str, optional: bool = False) -> str:
    return run("git", *args, optional=optional)


def validate_branch(branch: str) -> None:
    if not branch or branch.startswith("-"):
        raise RuntimeError(f"Invalid branch name: {branch!r}")
    git("check-ref-format", "refs/heads/" + branch)


def check_checkout(root: Path, branch: str) -> None:
    markers = (
        "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "REBASE_HEAD",
        "rebase-merge", "rebase-apply", "sequencer", "BISECT_START",
    )
    paths = git("rev-parse", *(arg for marker in markers for arg in ("--git-path", marker)))
    if any(Path(path).exists() for path in paths.splitlines()):
        raise RuntimeError("Finish or abort the current Git operation before reviewing.")
    if git("ls-files", "--unmerged"):
        raise RuntimeError("Resolve unmerged files before reviewing.")
    changes = git("diff", "--name-only", "--ignore-submodules=none", "-z")
    if changes:
        raise RuntimeError("Unstaged edits exist; stage or save them before reviewing. Nothing discarded.")
    for entry in git("worktree", "list", "--porcelain", "-z").split("\0\0"):
        fields = entry.split("\0")
        if "branch refs/heads/" + branch in fields:
            location = next(field.removeprefix("worktree ") for field in fields if field.startswith("worktree "))
            if Path(location).resolve() != root.resolve():
                raise RuntimeError(f"Branch {branch} is checked out in another worktree: {location}")


def github_repo(remote: str) -> str:
    url = git("remote", "get-url", "--", remote)
    if "://" not in url and ":" in url:
        host, path = url.split(":", 1)
        host = host.rsplit("@", 1)[-1]
    else:
        parsed = urlsplit(url)
        host, path = parsed.hostname, parsed.path
    path = path.strip("/").removesuffix(".git")
    if not host or len(path.split("/")) != 2:
        raise RuntimeError("Cannot identify the GitHub repository; use --base <branch> to skip PR lookup.")
    return f"{host}/{path}"


def check_restore(head: str) -> bool:
    changes = git("diff", "--cached", "--name-status", "--no-renames", "-z", head, "--")
    if not changes:
        return False
    fields = changes.rstrip("\0").split("\0")
    # Only paths present in the destination but absent from the index can collide
    # with untracked files. Existing index paths are covered by the unstaged check.
    paths = {path for status, path in zip(fields[::2], fields[1::2]) if status == "D"}
    if not paths:
        return True
    # Include ignored files too: Git normally allows a checkout to overwrite them.
    entries = git("ls-files", "--others", "--directory", "--no-empty-directory", "-z").split("\0")
    parents = set()
    for path in paths:
        parts = path.split("/")
        parents.update("/".join(parts[:index]) for index in range(1, len(parts)))
    overlapping_directories = []
    protected = []
    for entry in entries:
        if not entry:
            continue
        path = entry.rstrip("/")
        if entry.endswith("/") and path in parents:
            overlapping_directories.append(":(literal)" + entry)
        else:
            protected.append(path)
    if overlapping_directories:
        protected.extend(git("ls-files", "--others", "-z", "--", *overlapping_directories).split("\0"))
    for entry in protected:
        path = entry.rstrip("/")
        parts = path.split("/")
        if path in parents or any("/".join(parts[:index]) in paths for index in range(1, len(parts) + 1)):
            raise RuntimeError(f"Untracked or ignored path would be overwritten: {path!r}. Nothing discarded.")
    return True


def pr_base(remote: str, head_branch: str) -> str:
    pr = json.loads(run(
        "gh", "pr", "view", head_branch, "--repo", github_repo(remote),
        "--json", "baseRefName,headRefName,isCrossRepository",
    ))
    if pr["isCrossRepository"] or pr["headRefName"] != head_branch:
        raise RuntimeError("PR head does not match this remote branch; specify --remote and --base explicitly.")
    return pr["baseRefName"]


def ssh_options(remote: str) -> tuple:
    if not hasattr(os, "getuid") or any(key in os.environ for key in ("GIT_SSH", "GIT_SSH_COMMAND", "GIT_SSH_VARIANT")):
        return ()
    if git("config", "--get", "core.sshCommand", optional=True):
        return ()
    if git("config", "--bool", "--get", "review.reuseSSH", optional=True) == "false":
        return ()
    url = git("remote", "get-url", "--", remote)
    if not url.startswith("ssh://") and not ("://" not in url and ":" in url and not url.startswith("/")):
        return ()
    directory = Path(tempfile.gettempdir()) / f"git-review-ssh-{os.getuid()}"
    # Key by URL as well as SSH's connection identity to keep SSH aliases apart.
    remote_key = hashlib.sha256(url.encode()).hexdigest()[:12]
    control_path = str(directory / (remote_key + "-%C"))
    if len(os.fsencode(control_path.replace("%C", "0" * 40))) > 100:
        return ()
    try:
        directory.mkdir(mode=0o700, exist_ok=True)
        metadata = directory.lstat()
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
            return ()
    except OSError:
        return ()
    command = shlex.join([
        "ssh", "-o", "ControlMaster=auto", "-o", "ControlPersist=300",
        "-o", "ControlPath=" + control_path,
    ])
    return ("-c", "core.sshCommand=" + command)


def fetch_review(remote: str, head_branch: str, base: str) -> None:
    validate_branch(base)
    if base == head_branch:
        raise RuntimeError("The review branch must differ from its base branch.")
    git(
        *ssh_options(remote), "fetch", "--atomic", "--no-tags", "--", remote,
        f"+refs/heads/{head_branch}:refs/remotes/{remote}/{head_branch}",
        f"+refs/heads/{base}:refs/remotes/{remote}/{base}",
    )


def refresh(remote: str, branch: str, head_branch: str, base: Optional[str]) -> str:
    if base:
        fetch_review(remote, head_branch, base)
        return base
    hint = git("config", "--get", f"branch.{branch}.reviewBase", optional=True)
    with ThreadPoolExecutor(max_workers=2) as executor:
        lookup = executor.submit(pr_base, remote, head_branch)
        fetch = executor.submit(fetch_review, remote, head_branch, hint) if hint else None
        base = lookup.result()
        if fetch:
            try:
                fetch.result()
            except RuntimeError:
                # A retargeted PR may have had its previous base branch deleted.
                if hint == base:
                    raise
        if not fetch or hint != base:
            fetch_review(remote, head_branch, base)
    return base


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("branch", nargs="?", help="local branch to review (default: current branch)")
    parser.add_argument("--base", metavar="BRANCH", help="remote base branch, skipping GitHub PR lookup")
    parser.add_argument("--remote", help="remote to fetch (default: branch's upstream remote, or origin)")
    args = parser.parse_args()
    try:
        root = Path(git("rev-parse", "--show-toplevel"))
        os.chdir(root)
        branch = args.branch or git("symbolic-ref", "--quiet", "--short", "HEAD", optional=True)
        if not branch:
            raise RuntimeError("Detached HEAD; specify a branch to review.")
        validate_branch(branch)
        check_checkout(root, branch)
        configured_remote = git("config", "--get", f"branch.{branch}.remote", optional=True)
        remote = args.remote or configured_remote or "origin"
        if remote == ".":
            raise RuntimeError("The branch tracks a local branch; specify --remote <name>.")
        upstream = git("config", "--get", f"branch.{branch}.merge", optional=True)
        head_branch = upstream.removeprefix("refs/heads/") if upstream else branch
        validate_branch(head_branch)
        base = refresh(remote, branch, head_branch, args.base)
        head_ref = f"refs/remotes/{remote}/{head_branch}"
        base_ref = f"refs/remotes/{remote}/{base}"
        head = git("rev-parse", "--verify", head_ref + "^{commit}")
        base_head = git("rev-parse", "--verify", base_ref + "^{commit}")
        ancestor = git("merge-base", head, base_head)
        behind = int(git("rev-list", "--count", head + ".." + base_head))
        # Recheck after network operations before making the disposable changes.
        check_checkout(root, branch)
        restore_needed = check_restore(head)
        git("config", f"branch.{branch}.reviewBase", base)
        if restore_needed:
            git("restore", "--source=" + head, "--staged", "--worktree", "--", ".")
        git("switch", "--no-overwrite-ignore", "-C", branch, head)
        if configured_remote != remote or upstream != "refs/heads/" + head_branch:
            git("branch", "--set-upstream-to=" + head_ref, "--", branch)
        git("reset", "--soft", ancestor)
        print(f"Reviewing {branch} at {head[:12]} against {remote}/{base} (merge base {ancestor[:12]}).")
        if behind:
            print(f"The author's branch is behind its base by {behind} commit(s); no rebase performed.")
        print(git("diff", "--cached", "--stat") or "No branch changes to review.")
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        print(f"git review: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
